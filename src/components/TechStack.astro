---
import type { StackGroup } from "../data/stack";
type Props = { groups: StackGroup[] };
const { groups } = Astro.props;
---
<div class="stack-grid">{groups.map(group => <article class="stack-group"><h3>{group.title}</h3><p>{group.description}</p><ul class="tags">{group.items.map(item => <li class="tag">{item}</li>)}</ul></article>)}</div>
