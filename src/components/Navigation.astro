---
import { withBase, withoutBase } from "../utils/paths";
const isHome = withoutBase(Astro.url.pathname) === "/";
const sectionHref = (hash: string) => isHome ? hash : withBase(`/${hash}`);
const links = [
  { label: "Now", id: "current-chapter" }, { label: "About", id: "sobre-mi" },
  { label: "Ventures", id: "proyectos" }, { label: "Journey", id: "journey" },
  { label: "Evidence", id: "certificados" }, { label: "Sports", id: "trayectoria-deportiva" },
  { label: "Stack", id: "stack" }, { label: "Contact", id: "contacto" },
];
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-cyan-300/10 bg-[#06141b]/90 shadow-2xl shadow-black/20 backdrop-blur-2xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:px-10" aria-label="Primary">
    <a href={sectionHref("#inicio")} class="inline-flex items-center gap-3" aria-label="Caleb Perez — home"><span class="grid size-9 place-items-center rounded-2xl border border-cyan-300/30 bg-cyan-300/10 text-sm font-bold text-cyan-200">CP</span><span class="hidden text-sm font-semibold text-white sm:block">Caleb Perez</span></a>
    <div class="hidden items-center gap-0.5 rounded-full border border-white/10 bg-white/[0.03] p-1 xl:flex">{links.map((link) => <a href={sectionHref(`#${link.id}`)} data-nav-section={link.id} class="nav-pill rounded-full px-3 py-2 text-sm text-slate-300 transition hover:bg-white/10 hover:text-white">{link.label}</a>)}</div>
    <a href="mailto:calebdani@icloud.com" class="btn-primary shrink-0 px-4 py-2 text-sm">Let’s talk</a>
  </nav>
  <nav class="border-t border-white/5 px-5 pb-2 xl:hidden" aria-label="Section navigation"><div class="flex gap-2 overflow-x-auto pt-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">{links.map((link) => <a href={sectionHref(`#${link.id}`)} data-nav-section={link.id} class="nav-pill-mobile shrink-0 rounded-full border border-white/10 bg-white/[0.04] px-3 py-2 text-xs font-medium text-slate-300">{link.label}</a>)}</div></nav>
</header>
<div class="h-[7.25rem] xl:h-[4.5rem]" aria-hidden="true"></div>
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-section]"));
  const ids = [...new Set(links.map((link) => link.dataset.navSection).filter((id): id is string => Boolean(id)))];
  const sections = ids.map((id) => document.getElementById(id)).filter((section): section is HTMLElement => section !== null);
  if (sections.length > 0) {
    let scheduled = false;
    const update = () => {
      const threshold = (document.querySelector("header")?.getBoundingClientRect().height ?? 0) + 120;
      const visible = sections.filter((section) => section.getBoundingClientRect().top <= threshold);
      const active = visible.at(-1)?.id;
      links.forEach((link) => {
        if (link.dataset.navSection === active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
      scheduled = false;
    };
    const requestUpdate = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } };
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate, { passive: true });
    window.addEventListener("hashchange", requestUpdate);
    update();
  }
</script>
