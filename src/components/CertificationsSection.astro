---
import type { CertificationProgram, RecognitionItem } from "../data/certifications";
import SectionHeader from "./SectionHeader.astro";
import { withBase } from "../utils/paths";
type Props = { certifications: CertificationProgram[]; recognitions: RecognitionItem[] };
const { certifications, recognitions } = Astro.props;
---
<section id="certificados" class="section section-soft"><div class="shell">
  <SectionHeader eyebrow="06 / Learning & evidence" title="Foundations, not just labels." description="Technical training and experiences that support the work. Original certificates remain available to view and download." />
  <div class="credentials-grid">{certifications.map(program => <article class="credential">
    <p class="eyebrow">{program.issuer}</p><h3>{program.title}</h3><p>{program.summary}</p>
    <details class="disclosure"><summary>View certificates <span class="small muted">{program.mainCertificates.length + program.courseCertificates.length} PDFs</span></summary><div class="disclosure-content">
      {[...program.mainCertificates, ...program.courseCertificates].map(certificate => <div class="credential-evidence">
        {certificate.previewImage && <img src={withBase(certificate.previewImage)} alt={certificate.previewAlt ?? `${certificate.title} certificate preview`} width="900" height="695" loading="lazy" decoding="async" />}
        <h4>{certificate.title}</h4><p>{certificate.focus}</p>
        <div class="actions"><a class="text-link" href={withBase(certificate.href)} target="_blank" rel="noopener noreferrer" aria-label={`View ${certificate.title} PDF`}>View PDF ↗</a><a class="text-link" href={withBase(certificate.href)} download aria-label={`Download ${certificate.title}`}>Download ↓</a></div>
      </div>)}
    </div></details>
  </article>)}</div>
  <details class="disclosure" style="margin-top:36px"><summary>Beyond the certificates — international experience & recognition</summary><div class="recognition-grid">{recognitions.map(item => <article class="recognition-card">{item.image && <img src={withBase(item.image)} alt={item.imageAlt ?? item.title} loading="lazy" decoding="async" width="600" height="450" />}<p class="label">{item.context}</p><h4>{item.title}</h4><p>{item.description}</p></article>)}</div></details>
</div></section>
