---
import type { TimelineItem } from "../data/timeline";
type Props = { items: TimelineItem[] };
const { items } = Astro.props;
const recent = [...items].reverse().slice(0,2);
const earlier = [...items].reverse().slice(2);
---
<div class="timeline">{recent.map(item => <article class="timeline-row"><p class="period">{item.period}</p><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
<details class="disclosure"><summary>Earlier chapters — Mexico, New Zealand and independent projects</summary><div class="disclosure-content">{earlier.map(item => <article class="timeline-row"><p class="period">{item.period}</p><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div></details>
