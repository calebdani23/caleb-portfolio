---
import type { Project } from "../data/projects";
import { withBase } from "../utils/paths";
type Props = { project: Project };
const { project } = Astro.props;
const href = withBase(project.href ?? `/proyectos/${project.slug}/`);
---
<article class="project-card">
  <a class="project-visual" href={href} aria-label={`View ${project.title} case study`}>
    {project.previewImage && <img src={withBase(project.previewImage)} alt={project.previewAlt ?? `${project.title} preview`} width="900" height="560" loading="lazy" decoding="async" style={`object-fit:${project.previewObjectFit ?? 'cover'};object-position:${project.previewObjectPosition ?? 'top center'}`} />}
    <span class="card-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-info"><div class="row"><h3><a href={href}>{project.title}</a></h3><span class="tag">{project.status}</span></div><p class="category">{project.category}</p><p>{project.description}</p><div class="tags">{project.tags.slice(0,3).map(tag => <span class="tag">{tag}</span>)}</div></div>
</article>
