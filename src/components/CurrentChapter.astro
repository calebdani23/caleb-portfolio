---
import { currentChapter } from "../data/currentChapter";
const { education, venture } = currentChapter;
---
<section id="current-chapter" class="px-5 py-16 sm:px-8 lg:px-10" aria-labelledby="chapter-heading">
  <div class="mx-auto max-w-7xl">
    <div class="section-reveal mb-8 max-w-3xl">
      <p class="eyebrow">Now · {currentChapter.updated}</p>
      <h2 id="chapter-heading" class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">A new chapter in India.</h2>
      <p class="mt-5 text-lg leading-8 text-slate-300">From independent building to studying, collaborating and developing a venture in an international environment.</p>
    </div>
    <div class="grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
      <article class="premium-card section-reveal p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-200">Education in progress</p>
          <span class="rounded-full border border-white/15 px-3 py-1 text-xs text-slate-200">{education.cohort}</span>
        </div>
        <h3 class="mt-5 text-3xl font-semibold text-white">{education.institution}</h3>
        <p class="mt-3 text-lg text-cyan-100">{education.degree}</p>
        <p class="mt-3 text-sm text-slate-400">{education.period} · {education.term}</p>
        <p class="mt-6 max-w-2xl leading-7 text-slate-300">{education.summary}</p>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Current learning focus">
          {education.focus.map((item) => <li class="rounded-full bg-white/[0.05] px-3 py-2 text-xs text-slate-200">{item}</li>)}
        </ul>
      </article>
      <article class="surface-elevated section-reveal stagger-1 p-6 sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-200">Learning through venture development</p>
        <h3 class="mt-5 text-2xl font-semibold text-white">From coursework to product decisions.</h3>
        <p class="mt-5 leading-7 text-slate-300">Working with a three-person team has added a new dimension to my experience: defining a shared problem, making technical trade-offs and turning research into something we can test.</p>
        <dl class="mt-6 space-y-4 border-t border-white/10 pt-5 text-sm">
          <div><dt class="text-slate-400">Venture</dt><dd class="mt-1 font-medium text-white">{venture.company} · {venture.product}</dd></div>
          <div><dt class="text-slate-400">My contribution</dt><dd class="mt-1 font-medium text-white">{venture.role}</dd></div>
        </dl>
        <a href="#adren-ai" class="link-cta mt-6 text-sm">See what I am building <span aria-hidden="true">↓</span></a>
      </article>
    </div>
  </div>
</section>
