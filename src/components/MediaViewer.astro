<dialog class="lightbox" id="media-viewer" aria-labelledby="media-title">
  <div class="lightbox-header"><h2 id="media-title">Project evidence</h2><form method="dialog"><button type="submit" aria-label="Close expanded image">×</button></form></div>
  <img id="media-image" alt="" />
  <p id="media-caption"></p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#media-viewer');
  const image = document.querySelector<HTMLImageElement>('#media-image');
  let previous: HTMLElement | null = null;
  if (dialog && image) {
    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach(link => link.addEventListener('click', event => {
      event.preventDefault();
      previous = link;
      image.src = link.href;
      image.alt = link.querySelector('img')?.alt ?? 'Project evidence';
      const title = document.querySelector('#media-title');
      const caption = document.querySelector('#media-caption');
      if (title) title.textContent = link.dataset.title ?? 'Project evidence';
      if (caption) caption.textContent = link.dataset.caption ?? '';
      dialog.showModal();
      document.documentElement.dataset.modal = 'open';
    }));
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
    dialog.addEventListener('close', () => {
      delete document.documentElement.dataset.modal;
      previous?.focus();
      image.removeAttribute('src');
    });
  }
</script>
