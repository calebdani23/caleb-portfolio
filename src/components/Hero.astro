---
import { profile } from "../data/profile";
import { withBase } from "../utils/paths";
---
<section id="inicio" class="hero"><div class="shell">
  <div class="hero-grid">
    <div>
      <p class="eyebrow">Caleb Perez · Product & Artificial Intelligence</p>
      <h1>Real problems.<br />Thoughtful <span class="serif">software.</span></h1>
      <p class="hero-intro">I connect business context, software and AI to build useful products. Currently studying at <strong>TETR</strong> and building <strong>Adren.ai</strong> with the <strong>AdrenLabs</strong> founding team.</p>
      <div class="actions"><a class="button" href="#proyectos">Explore my work <span aria-hidden="true">↘</span></a><a class="button button-secondary" href="#sobre-mi">A little about me</a></div>
      <div class="hero-links">{profile.links.filter(link => link.label !== 'Instagram').map(link => <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-photo"><img src={withBase(profile.photo.src)} alt={profile.photo.alt} width="640" height="800" loading="eager" fetchpriority="high" decoding="async" /></div>
      <figcaption><div><strong>Caleb Perez</strong><span>From Mexico. Building in India.</span></div><span class="portrait-seal" aria-hidden="true">cp.</span></figcaption>
    </figure>
  </div>
  <dl class="hero-ledger">
    <div><dt class="label">Building</dt><dd><a href="https://adrenlabs.ai/" target="_blank" rel="noopener noreferrer">AdrenLabs ↗</a> / <a href="https://adren.ai/" target="_blank" rel="noopener noreferrer">Adren.ai ↗</a></dd></div>
    <div><dt class="label">Studying</dt><dd>TETR · BSc Artificial Intelligence</dd></div>
    <div><dt class="label">Based in</dt><dd>{profile.location}</dd></div>
  </dl>
</div></section>
