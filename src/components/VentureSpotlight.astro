---
import { currentChapter } from "../data/currentChapter";
import { withBase } from "../utils/paths";
const { venture } = currentChapter;
---
<article id="adren-ai" class="premium-card relative overflow-hidden scroll-mt-36 p-6 sm:p-8 lg:p-10" aria-labelledby="venture-heading">
  <div class="grid gap-9 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <p class="eyebrow">Current venture</p>
        <span class="rounded-full border border-cyan-200/20 bg-cyan-200/10 px-3 py-1 text-xs text-cyan-100">{venture.status}</span>
      </div>
      <p class="mt-7 text-sm text-slate-300">Built with {venture.company}</p>
      <h3 id="venture-heading" class="mt-2 text-5xl font-semibold tracking-tight text-white sm:text-6xl">{venture.product}</h3>
      <p class="mt-6 text-lg leading-8 text-slate-200">{venture.summary}</p>
      <p class="mt-5 leading-7 text-slate-300">{venture.context}</p>
      <p class="mt-5 text-sm font-medium text-cyan-200">{venture.role} · {venture.period}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase("/proyectos/adren-ai/")} class="btn-primary px-5 py-3 text-sm">My work on Adren.ai</a>
        <a href={venture.productUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary px-5 py-3 text-sm">Visit Adren.ai ↗</a>
        <a href={venture.companyUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary px-5 py-3 text-sm">AdrenLabs ↗</a>
      </div>
    </div>
    <div class="surface-inset p-5 sm:p-7">
      <p class="text-sm font-semibold text-white">From business context to a testable direction.</p>
      <p class="mt-2 text-xs leading-5 text-slate-400">Product direction · conceptual workflow, not a live product demo</p>
      <ol class="mt-6 space-y-3">
        {venture.workflow.map((step, index) => (
          <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-4 transition hover:border-cyan-200/30">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-cyan-300/10 text-xs font-semibold text-cyan-200">{String(index + 1).padStart(2, "0")}</span>
            <div><p class="font-medium text-white">{step.title}</p><p class="mt-1 text-sm leading-6 text-slate-300">{step.detail}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="mt-9 grid gap-5 border-t border-white/10 pt-7 sm:grid-cols-2 lg:grid-cols-4">
    {venture.contributions.map((item) => <div><h4 class="text-sm font-semibold text-cyan-100">{item.title}</h4><p class="mt-2 text-sm leading-6 text-slate-300">{item.detail}</p></div>)}
  </div>
</article>
