---
import { currentChapter } from "../data/currentChapter";
import { withBase } from "../utils/paths";
const { venture } = currentChapter;
---
<article id="adren-ai" class="venture-card" aria-labelledby="venture-heading">
  <div class="venture-top"><p class="eyebrow">01 / Current venture · AdrenLabs</p><span class="tag tag-dot">In development</span></div>
  <div class="venture-grid">
    <div>
      <h3 class="venture-title" id="venture-heading">Adren.ai</h3>
      <p class="venture-deck">Understand the business.<br />Build what matters.</p>
      <p class="venture-copy">Developing AI-assisted workflows that turn operational context into actionable requirements, prototypes and implementation priorities.</p>
      <p class="venture-role">{venture.role} · {venture.period}</p>
      <div class="actions"><a class="button" href={withBase("/proyectos/adren-ai/")}>Explore my contribution <span aria-hidden="true">↗</span></a></div>
      <div class="actions"><a class="text-link" href={venture.productUrl} target="_blank" rel="noopener noreferrer">Adren.ai ↗</a><a class="text-link" href={venture.companyUrl} target="_blank" rel="noopener noreferrer">AdrenLabs ↗</a></div>
    </div>
    <div class="venture-flow"><p class="label">Product direction / conceptual workflow</p><ol>{venture.workflow.map((step,index) => <li class="flow-row"><span class="flow-number">{String(index+1).padStart(2,'0')}</span><div><h4>{step.title}</h4><p>{step.detail}</p></div></li>)}</ol></div>
  </div>
  <div class="venture-bottom">{venture.contributions.map(item => <div><h4>{item.title}</h4><p>{item.detail}</p></div>)}</div>
</article>
<div class="venture-caption"><span>AdrenLabs is the venture. Adren.ai is the product.</span><span>Three-person team · First semester at TETR</span></div>
