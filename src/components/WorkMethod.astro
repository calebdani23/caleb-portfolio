---
import type { WorkStep } from "../data/workMethod";
type Props = { steps: WorkStep[] };
const { steps } = Astro.props;
---
<ol class="work-method">{steps.map((step,index) => <li class="method-step"><span class="number">{String(index+1).padStart(2,'0')}</span><h3>{step.title}</h3><p>{step.description}</p><small>{step.outcome}</small></li>)}</ol>
