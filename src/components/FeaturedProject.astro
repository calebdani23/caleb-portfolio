---
import type { Project } from "../data/projects";
import { withBase } from "../utils/paths";
type Props = { project: Project };
const { project } = Astro.props;
const featuredImage = project.featuredImage ?? project.previewImage;
---
<article id="zalmar-travel" class="premium-card scroll-mt-36 overflow-hidden p-6 sm:p-8 lg:p-10">
  <div class="grid items-start gap-8 lg:grid-cols-[0.85fr_1.15fr]">
    <div>
      <div class="flex flex-wrap gap-3"><p class="eyebrow">Independent travel-tech project</p><span class="rounded-full border border-amber-200/20 bg-amber-200/10 px-3 py-1 text-xs text-amber-100">{project.status}</span></div>
      {project.brandImage && <img src={withBase(project.brandImage)} alt={project.brandAlt ?? `${project.title} logo`} width="48" height="48" loading="lazy" class="mt-6 size-12 object-contain" />}
      <h3 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">{project.title}</h3>
      <p class="mt-5 text-lg leading-8 text-slate-300">{project.description}</p>
      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">{project.metrics?.map((metric) => <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4"><p class="text-xl font-semibold text-white">{metric.value}</p><p class="mt-1 text-xs text-slate-400">{metric.label}</p></div>)}</div>
      {project.href && <a href={withBase(project.href)} class="btn-secondary mt-7 px-5 py-3 text-sm">Explore the Zalmar case study</a>}
    </div>
    <div>
      {featuredImage && <figure class="browser-frame"><img src={withBase(featuredImage)} alt={project.previewAlt ?? `Product interface for ${project.title}`} loading="lazy" decoding="async" class="aspect-[16/10] w-full bg-slate-950 object-cover" style={`object-fit: ${project.previewObjectFit ?? "cover"}; object-position: ${project.previewObjectPosition ?? "top center"};`} /><figcaption class="media-caption px-4 py-3">Spanish-language MVP evidence from the plan-first booking journey.</figcaption></figure>}
      <div class="mt-5 grid gap-3 sm:grid-cols-2">{project.highlights?.map((highlight) => <p class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-sm leading-6 text-slate-300">{highlight}</p>)}</div>
      <p class="mt-5 text-sm leading-6 text-slate-400">An in-development project that established my hands-on experience with travel operations, API integration and booking UX. Screens illustrate the MVP, not a claim of commercial scale.</p>
    </div>
  </div>
</article>
