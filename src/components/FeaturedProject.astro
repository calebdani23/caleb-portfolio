---
import type { Project } from "../data/projects";
import { withBase } from "../utils/paths";
type Props = { project: Project };
const { project } = Astro.props;
const image = project.featuredImage ?? project.previewImage;
---
<article id="zalmar-travel" class="featured-work">
  <div><p class="eyebrow">02 / Independent product</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags"><span class="tag tag-dot">{project.status}</span><span class="tag">Travel tech</span><span class="tag">API orchestration</span></div>{project.href && <div class="actions"><a class="text-link" href={withBase(project.href)}>View case study <span aria-hidden="true">↗</span></a></div>}</div>
  {image && <figure class="work-image"><a href={withBase(project.href ?? '/#proyectos')} aria-label={`Explore ${project.title}`}><img src={withBase(image)} alt={project.previewAlt ?? `${project.title} interface`} width="960" height="600" loading="lazy" decoding="async" /></a><figcaption>Spanish-language MVP · Plan-first booking workspace</figcaption></figure>}
</article>
