---
import type { SportsHighlight } from "../data/sports";
import SectionHeader from "./SectionHeader.astro";
import { withBase } from "../utils/paths";
type Props = { highlights: SportsHighlight[] };
const { highlights } = Astro.props;
---
<section id="trayectoria-deportiva" class="section"><div class="shell">
  <SectionHeader eyebrow="07 / Beyond the work" title="Discipline has more than one field." description="Football taught me consistency, teamwork and how to perform under pressure. These moments remain part of how I work today." />
  <div class="sports-grid">{highlights.map((item,index) => <article class="sports-card">
    {(item.videos.length > 0 || (item.photos?.length ?? 0) > 0) && <>
      <div class="sports-carousel" id={`sports-carousel-${index}`} tabindex="0" role="region" aria-label={`Media for ${item.title}`}>
        {item.videos.length > 0 ? item.videos.map((video,i) => <figure><video controls preload="none" playsinline poster={withBase(video.poster)} aria-label={`${video.label} for ${item.title}`}><source src={withBase(video.src)} type="video/mp4" />Your browser does not support this video.</video><figcaption>{video.label} · {video.note} <span class="small">({i+1}/{item.videos.length})</span></figcaption></figure>) : item.photos?.map((photo,i) => <figure><img src={withBase(photo.src)} alt={photo.alt} width="800" height="450" loading="lazy" decoding="async" /><figcaption>{photo.label} · {photo.note} <span class="small">({i+1}/{item.photos?.length})</span></figcaption></figure>)}
      </div>
      <div class="carousel-controls"><button type="button" data-carousel-target={`sports-carousel-${index}`} data-direction="prev" aria-label={`Previous media for ${item.title}`}>←</button><span>Swipe or use the arrows</span><button type="button" data-carousel-target={`sports-carousel-${index}`} data-direction="next" aria-label={`Next media for ${item.title}`}>→</button></div>
    </>}
    <p class="label">{item.context}</p><h3>{item.title}</h3><p>{item.description}</p>
  </article>)}</div>
</div></section>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-carousel-target]').forEach(button => button.addEventListener('click', () => {
    const carousel = document.getElementById(button.dataset.carouselTarget ?? '');
    if (!carousel) return;
    const direction = button.dataset.direction === 'prev' ? -1 : 1;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    carousel.scrollBy({ left: (carousel.clientWidth + 16) * direction, behavior: reduced ? 'instant' : 'smooth' });
  }));
</script>
