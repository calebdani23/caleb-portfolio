---
import { profile } from "../data/profile";
const contactLinks = [{ label: "Email", value: profile.email, href: `mailto:${profile.email}` }, ...profile.links];
---
<section id="contacto" class="px-5 py-20 sm:px-8 lg:px-10">
  <div class="mx-auto max-w-5xl text-center"><div class="premium-card p-8 sm:p-10">
    <p class="eyebrow">Contact · {profile.location}</p>
    <h2 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">Good conversations become better products.</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-300">Currently studying at TETR and building with AdrenLabs. I welcome conversations with founders, builders and mentors about applied AI, business operations, travel tech and thoughtful software.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">{contactLinks.map((link) => <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined} class="btn-secondary max-w-full break-all px-5 py-3 text-sm" aria-label={`${link.label}: ${link.value}`}><span class="text-cyan-300">{link.label}:</span> {link.value}</a>)}</div>
  </div></div>
</section>
