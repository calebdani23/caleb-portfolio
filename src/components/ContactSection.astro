---
import { profile } from "../data/profile";
---
<section id="contacto" class="contact-section"><div class="shell contact-panel">
  <div><p class="eyebrow">Start a conversation</p><h2>Something worth<br /><span class="serif">building together?</span></h2></div>
  <div><a class="text-link email-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a><p>I welcome conversations with founders, builders and mentors about applied AI, thoughtful software and real business problems.</p><div class="contact-links">{profile.links.map(link => <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div><p class="small">{profile.location}<br />Studying at TETR · Building with AdrenLabs</p></div>
</div></section>
