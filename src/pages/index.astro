---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CurrentChapter from "../components/CurrentChapter.astro";
import VentureSpotlight from "../components/VentureSpotlight.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Timeline from "../components/Timeline.astro";
import CertificationsSection from "../components/CertificationsSection.astro";
import SportsSection from "../components/SportsSection.astro";
import TechStack from "../components/TechStack.astro";
import WorkMethod from "../components/WorkMethod.astro";
import ContactSection from "../components/ContactSection.astro";
import { featuredProject, projects } from "../data/projects";
import { timelineItems } from "../data/timeline";
import { certifications, recognitionItems } from "../data/certifications";
import { sportsHighlights } from "../data/sports";
import { stackGroups } from "../data/stack";
import { workSteps } from "../data/workMethod";
const supporting = projects.filter(project => project !== featuredProject);
---
<BaseLayout>
  <Hero />
  <section id="proyectos" class="section"><div class="shell">
    <SectionHeader eyebrow="01 — 02 / Selected work" title="Built with context. Made to be useful." description="A current team venture, an independent travel product, and the systems that support how I build." />
    <VentureSpotlight />
    <FeaturedProject project={featuredProject} />
    <div class="work-section-label"><p class="eyebrow">The systems behind the work</p><p class="small muted">Developer tools · Infrastructure · Evidence</p></div>
    <div class="project-grid">{supporting.map(project => <ProjectCard project={project} />)}</div>
  </div></section>
  <CurrentChapter />
  <section id="sobre-mi" class="section"><div class="shell about-grid">
    <div><p class="eyebrow">04 / A little about me</p><h2>A non-linear path.<br /><span class="serif">A clearer direction.</span></h2></div>
    <div class="about-copy"><p>I am Caleb Daniel Perez Rodriguez, from Playa del Carmen, Mexico. Business and engineering studies, self-directed technical training and a year living and working in New Zealand shaped the way I approach software.</p><p class="muted">Today, that path continues at TETR in India. I am studying Artificial Intelligence and developing Adren.ai with the AdrenLabs team — connecting business problems, agent workflows and practical product development.</p><div class="about-points"><div><h3>Learn through real work</h3><p>Google IT Support, Oracle Next Education / Alura and independent projects gave structure to my technical foundations.</p></div><div><h3>Keep the whole system in view</h3><p>Zalmar Travel began with real agency operations. That context still shapes how I think about users, integrations and trust.</p></div></div></div>
  </div></section>
  <section id="journey" class="section section-topline"><div class="shell"><SectionHeader eyebrow="05 / Trajectory" title="Experience that compounds." description="The current chapter, with the earlier experiences that brought me here." /><Timeline items={timelineItems} /></div></section>
  <CertificationsSection certifications={certifications} recognitions={recognitionItems} />
  <SportsSection highlights={sportsHighlights} />
  <section id="stack" class="section section-topline"><div class="shell"><SectionHeader eyebrow="08 / Capabilities" title="The toolkit follows the problem." description="Practical experience across software, AI-assisted development and infrastructure. Always learning, never collecting tools for their own sake." /><TechStack groups={stackGroups} /></div></section>
  <section id="forma-de-trabajo" class="section section-soft"><div class="shell"><SectionHeader eyebrow="09 / Approach" title="Understand. Build. Learn." description="A simple process, with care in the details. Evidence matters more than the promise of a perfect system." /><WorkMethod steps={workSteps} /></div></section>
  <ContactSection />
</BaseLayout>
