---
import BaseLayout from "./BaseLayout.astro";
import type { CaseStudy } from "../data/caseStudies";
import { withBase } from "../utils/paths";
type Props = { caseStudy: CaseStudy; previous?: CaseStudy; next?: CaseStudy };
const { caseStudy, previous, next } = Astro.props;
const sections = Object.values(caseStudy.sections);
const live: Record<string,string> = {
  'ai-agent-observability-dashboard': 'https://calebdani23.github.io/ai-agent-observability-dashboard/',
  'ai-codebase-explainer': 'https://calebdani23.github.io/ai-codebase-explainer/',
};
---
<BaseLayout title={`${caseStudy.title} — Caleb Perez case study`} description={caseStudy.summary} canonical={`/proyectos/${caseStudy.slug}/`}>
<article class="case-page"><div class="shell">
  <a class="text-link" href={withBase('/#proyectos')}>← All work</a>
  <header class="case-header"><p class="eyebrow">Selected work / Case study</p><h1>{caseStudy.title}</h1><p class="case-deck">{caseStudy.description}</p>{live[caseStudy.slug] && <div class="actions"><a class="button" href={live[caseStudy.slug]} target="_blank" rel="noopener noreferrer">Open live project ↗</a></div>}</header>
  <dl class="case-meta"><div><dt>Status</dt><dd>{caseStudy.status}</dd></div><div style="grid-column:span 2"><dt>My contribution</dt><dd>{caseStudy.role}</dd></div><div><dt>Focus</dt><dd>{caseStudy.highlights.slice(0,3).join(' · ')}</dd></div></dl>
  <div class="case-grid"><div><p class="label">Stack & concepts</p><ul class="tags" style="margin-top:18px">{caseStudy.stack.map(item => <li class="tag">{item}</li>)}</ul></div><p class="small muted">{caseStudy.summary}</p></div>
  <section style="margin-top:45px" aria-labelledby="case-flow-heading"><h2 id="case-flow-heading" style="font-size:1.3rem">How the system connects</h2><ol class="case-flow">{caseStudy.flow.map((step,index) => <li><span>{String(index+1).padStart(2,'0')}</span>{step}</li>)}</ol></section>
  {caseStudy.gallery && caseStudy.gallery.length > 0 && <section style="margin-top:65px" aria-labelledby="evidence-heading"><p class="eyebrow">The work, in view</p><h2 id="evidence-heading" style="font-size:2rem;margin-top:16px">Product & architecture evidence.</h2><div class="evidence-gallery">{caseStudy.gallery.map(item => <figure class="evidence-figure"><a class="evidence-image" href={withBase(item.src)} data-lightbox data-title={caseStudy.title} data-caption={item.caption} aria-label={`Expand image: ${item.alt}`}><img src={withBase(item.src)} alt={item.alt} loading="lazy" decoding="async" /><span aria-hidden="true">Expand ↗</span></a><figcaption>{item.caption}</figcaption></figure>)}</div></section>}
  {sections.map((section,index) => <section class="case-section"><div><p class="eyebrow">{String(index+1).padStart(2,'0')} / Case notes</p><h2>{section.title}</h2></div><div class="prose"><p>{section.body}</p>{section.bullets && <ul>{section.bullets.map(item => <li>{item}</li>)}</ul>}</div></section>)}
  <nav class="case-next" aria-label="Case study navigation">{previous ? <a href={withBase(`/proyectos/${previous.slug}/`)}><span>← Previous</span>{previous.title}</a> : <div />}{next && <a href={withBase(`/proyectos/${next.slug}/`)}><span>Next →</span>{next.title}</a>}</nav>
</div></article>
</BaseLayout>
