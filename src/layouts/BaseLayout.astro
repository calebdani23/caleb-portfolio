---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import MediaViewer from "../components/MediaViewer.astro";
import { withBase, withoutBase } from "../utils/paths";
const {
  title = "Caleb Perez — TETR AI Undergraduate & AdrenLabs Product Builder",
  description = "Caleb Perez: AI undergraduate at TETR in India, AdrenLabs founding team member building Adren.ai, and independent software and travel-tech builder.",
  canonical,
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(withBase(canonical ?? withoutBase(Astro.url.pathname)), Astro.site) : undefined;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ee" />
    <script is:inline>
      try {
        if (localStorage.getItem('cp-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Caleb Perez Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">Skip to content</a>
    <Navigation />
    <main id="contenido-principal" tabindex="-1"><slot /></main>
    <Footer />
    <MediaViewer />
  </body>
</html>
